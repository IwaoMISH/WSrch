    CONTROL         "List1",IDC_LIST_RESULTS,"SysListView32",LVS_REPORT | 
                    WS_BORDER | WS_TABSTOP,7,32,297,155
    DEFPUSHBUTTON   "検索",IDOK,260,7,50,14,NOT WS_TABSTOP
    PUSHBUTTON      "ｷｬﾝｾﾙ",IDCANCEL,260,23,50,14,NOT WS_VISIBLE | NOT 
                    WS_TABSTOP
END


