                    IDC_STATIC,40,30,162,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_WSRCH_DIALOG DIALOGEX 0, 0, 320, 200
STYLE WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Sample Windows Search"
FONT 9, "ＭＳ ゴシック"
BEGIN
    COMBOBOX        IDC_COMBO_EXT,7,7,54,135,CBS_DROPDOWN | CBS_AUTOHSCROLL | 
                    CBS_SORT | CBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
